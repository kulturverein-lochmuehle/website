# http://editorconfig.org

root = true

[*]
charset = utf-8
indent_style = space
indent_size = 2
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

# markdoc is markdown, and both keep the two trailing spaces that mean
# a line break
[*.{md,mdoc}]
insert_final_newline = false
trim_trailing_whitespace = false
