{
  "name": "@kvlm/website",
  "version": "0.0.2",
  "type": "module",
  "private": true,
  "description": "Kulturverein Lochmühle e.V.",
  "license": "MIT",
  "scripts": {
    "build:protocols": "node --env-file-if-exists=.env --import tsx scripts/fetch-protocols.ts",
    "build:functions": "tsc --project tsconfig.functions.json",
    "build:www": "cross-env NODE_ENV=production stencil build",
    "build": "run-s build:*",
    "start:functions": "netlify functions:serve",
    "start:www": "stencil build --dev --watch --serve",
    "start": "run-p start:*",
    "test": "stencil test --spec --e2e",
    "test:watch": "stencil test --spec --e2e --watchAll"
  },
  "dependencies": {
    "css-reset-and-normalize": "2.3.6",
    "handlebars": "4.7.9",
    "ical": "0.8.0",
    "marked": "18.0.13",
    "typeface-muli": "1.1.13"
  },
  "devDependencies": {
    "@netlify/functions": "6.0.0",
    "@stencil-community/postcss": "2.2.0",
    "@stencil/core": "4.45.0",
    "@stencil/router": "2.0.0-2",
    "@stencil/sass": "3.3.3",
    "@types/ical": "0.8.3",
    "@types/jest": "30.0.0",
    "@types/node": "24.13.6",
    "@types/node-fetch": "2.6.13",
    "autoprefixer": "10.6.1",
    "cross-env": "10.1.0",
    "fast-glob": "3.3.3",
    "googleapis": "181.0.0",
    "jest": "30.5.2",
    "jest-cli": "30.5.2",
    "netlify-cli": "27.8.0",
    "npm-run-all": "4.1.5",
    "prettier": "3.9.8",
    "puppeteer": "25.11.0",
    "rollup-plugin-node-polyfills": "0.2.1",
    "tsx": "4.23.15",
    "typescript": "7.0.2"
  }
}
