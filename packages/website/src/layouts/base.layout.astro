---
import '@kvlm/ui/globals.css';
import '@kvlm/ui/fonts.css';
import '@kvlm/ui/typography.css';

import { withBase } from '@/utils/base.utils.js';
import { documentTitle, SITE_TITLE } from '@/utils/title.utils.js';

export interface Props {
  lang?: string;
  siteTitle?: string;
  pageTitle?: string;
}

const { lang = 'de', siteTitle = SITE_TITLE, pageTitle } = Astro.props;
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href={withBase('favicon.svg')} />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta content="text/html; charset=utf-8" http-equiv="content-type" />
    <meta content="IE=Edge" http-equiv="x-ua-compatible" />

    <title>{documentTitle(pageTitle, siteTitle)}</title>

    <style is:global>
      html,
      body {
        margin: 0;
      }

      html {
        font-family: var(--kvlm-font-family-body);

        /* every colour of a page is painted by an element, so the canvas
           behind them is white - which is what shows while the next document
           is on its way and wherever a scroll bounces past the content */
        background-color: var(--kvlm-color-grey-dark);
        background-image: linear-gradient(
          150deg,
          var(--kvlm-color-turquoise) 0,
          var(--kvlm-color-spray) 100svh
        );
        background-repeat: no-repeat;
        background-size: 100svw 100svh;
        background-attachment: fixed;
      }

    </style>

    <slot name="head" />
  </head>
  <body>
    <slot />
    <script>
      // The components arrive rendered from the build; this lets them adopt
      // that markup instead of rendering a second copy next to it.
      import '@lit-labs/ssr-client/lit-element-hydrate-support.js';

      // `lit-element` picks the support up while it evaluates, and whether it
      // gets there first is not ours to decide: the build puts `lit-element` in
      // a chunk this module imports, so it runs before this body ever does. The
      // patch is applied by hand rather than relying on that order.
      // The support redefines `observedAttributes` on `LitElement` itself,
      // which inherits it from `ReactiveElement` until then, so an own property
      // is the marker - reading the value would throw on the base class.
      const { LitElement } = await import('lit');
      if (!Object.hasOwn(LitElement, 'observedAttributes')) {
        globalThis.litElementHydrateSupport({ LitElement });
      }

      // only now, so every element is defined against a patched base class
      const { startRouter } = await import('@kvlm/ui');

      // the page was rendered by one `render()` at the top, so no client side
      // part owns these nodes and clears the flag the server put on them -
      // document order hydrates each one after its host
      for (const element of document.querySelectorAll('[defer-hydration]')) {
        element.removeAttribute('defer-hydration');
      }

      // links are handled here from now on: a section of the page it is already
      // on scrolls, anything else swaps the content of the layout
      // the build writes what each route weighs, so a navigation can say how
      // far it has come. `BASE_URL` is `/website` on the project page and `/`
      // locally, so it is joined the way `withBase()` does it
      const base = import.meta.env.BASE_URL.replace(/\/$/, '');
      startRouter({ sizes: `${base}/routes.json` });
    </script>
  </body>
</html>
