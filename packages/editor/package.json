{
  "name": "@kvlm/editor",
  "description": "The editor of the Lochmühle's 3D model",
  "version": "0.0.1",
  "license": "MIT",
  "private": true,
  "author": {
    "name": "David Enke",
    "email": "david@kvlm.de"
  },
  "type": "module",
  "scripts": {
    "dev": "bun run --cwd ../visualization build && vite --host",
    "build": "bun run --cwd ../visualization build && tsc --noEmit && vite build",
    "preview": "vite build && vite preview",
    "lint": "eslint",
    "test": "cross-env NODE_OPTIONS='--import tsx/esm' NODE_NO_WARNINGS=1 wtr --config .configs/web-test-runner.config.ts",
    "test:watch": "npm test -- --watch"
  },
  "dependencies": {
    "@kvlm/ui": "workspace:*",
    "@kvlm/visualization": "workspace:*",
    "lit": "3.3.3",
    "three": "0.186.0"
  },
  "devDependencies": {
    "@awmottaz/prettier-plugin-void-html": "2.3.0",
    "@enke.dev/lint": "0.13.13",
    "@esm-bundle/chai": "4.3.4-fix.0",
    "@open-wc/testing": "5.0.0",
    "@remcovaes/web-test-runner-vite-plugin": "1.4.1",
    "@tsconfig/strictest": "2.0.8",
    "@types/mocha": "10.0.10",
    "@types/node": "24.13.4",
    "@types/three": "0.186.0",
    "@web/test-runner": "1.0.0",
    "@web/test-runner-commands": "1.0.1",
    "@web/test-runner-playwright": "1.0.0",
    "cross-env": "10.1.0",
    "eslint": "10.10.0",
    "eslint-formatter-junit": "9.0.1",
    "jiti": "2.7.0",
    "prettier": "3.9.8",
    "tsx": "4.23.13",
    "typescript": "6.0.3",
    "vite": "8.3.0"
  }
}
