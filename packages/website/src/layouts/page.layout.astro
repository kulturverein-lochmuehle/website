---
import { getEntry, render } from 'astro:content';

import Footer from '@/components/footer.component.astro';
import Navigation from '@/components/navigation.component.astro';
import Section from '@/components/section.component.astro';
import DefaultLayout from '@/layouts/default.layout.astro';
import { getCalendarLinks } from '@/utils/calendar.utils.js';
import { getDefaultRoute, prepareNavigation } from '@/utils/navigation.utils.js';
import { getSections } from '@/utils/section.utils.js';

export type Props = {
  /** id of the page collection entry */
  slug: string;
  /** path the visitor came in on, used to mark the navigation */
  current?: string;
};

const { slug, current } = Astro.props;

const page = await getEntry('pages', slug);
if (page === undefined) throw new Error(`Unknown page "${slug}"`);

const { Content } = await render(page);
const sections = getSections(page);
// a page without sections of its own is wrapped in a single implicit one
const sectioned = sections.length > 0;

// a section deep link is its own history entry and deserves its own title
const [, anchor] = current?.split('/') ?? [];
const section = sections.find(({ id }) => id === anchor);
const home = await getDefaultRoute();
// content links to the calendar feed the events are read from
const calendar = getCalendarLinks();
const items = await prepareNavigation('main', current);
const legal = await prepareNavigation('footer', current);
---

<DefaultLayout pageTitle={section?.title ?? page.data.title} observeScroll>
  <Navigation slot="header" current={current} href={home} items={items} secondary={legal} />
  <Footer slot="footer" items={legal} />
  {
    sectioned ? (
      <Content page={page.id} calendar={calendar} />
    ) : (
      <Section page={page.id} title={page.data.title} theme={page.data.theme}>
        <Content page={page.id} calendar={calendar} />
      </Section>
    )
  }
</DefaultLayout>
