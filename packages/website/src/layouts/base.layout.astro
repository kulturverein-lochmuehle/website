---
export interface Props {
  lang?: string;
  siteTitle?: string;
  pageTitle?: string;
}

const { lang = 'de', siteTitle = 'Kulturverein Lochmühle e.V.', pageTitle } = Astro.props;
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta content="text/html; charset=utf-8" http-equiv="content-type" />
    <meta content="IE=Edge" http-equiv="x-ua-compatible" />

    <title>{pageTitle ? `${pageTitle} | ${siteTitle}` : siteTitle}</title>

    <link href="/ui/globals.css" rel="stylesheet" />
    <link href="/ui/fonts.css" rel="stylesheet" />
    <style>
      html,
      body {
        margin: 0;
      }

      html {
        font-family: var(--kvlm-font-family-body);
      }
    </style>

    <script is:inline type="importmap">
      {
        "imports": {
          "element-internals-polyfill": "/ui/libs/element-internals-polyfill/dist/index.js",
          "urlpattern-polyfill": "/ui/libs/urlpattern-polyfill/index.js",
          "@lit/reactive-element": "/ui/libs/@lit/reactive-element/reactive-element.js",
          "@lit/reactive-element/": "/ui/libs/@lit/reactive-element/",
          "lit": "/ui/libs/lit/index.js",
          "lit/": "/ui/libs/lit/",
          "lit-element/": "/ui/libs/lit-element/",
          "lit-html": "/ui/libs/lit-html/lit-html.js",
          "lit-html/": "/ui/libs/lit-html/",
          "lodash-es/": "/ui/libs/lodash-es/"
        }
      }
    </script>

    <script is:inline src="https://identity.netlify.com/v1/netlify-identity-widget.js"></script>
    <script is:inline src="/ui/index.js" type="module"></script>
    <slot name="head" />
  </head>
  <body>
    <slot />
  </body>
</html>
