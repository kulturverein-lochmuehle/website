{
  "name": "@kvlm/source",
  "description": "Monorepo of the Kulturverein Lochmühle e.V.",
  "version": "0.0.1",
  "license": "MIT",
  "private": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/kulturverein-lochmuehle/website.git"
  },
  "packageManager": "bun@1.4.4",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "check": "bun run --filter '*' check",
    "lint": "bun run --filter '*' lint",
    "test": "bun run --filter '*' test",
    "dev": "bun run --sequential dev:model dev:all",
    "build": "bun run --sequential build:website build:editor",
    "dev:model": "bun run --filter @kvlm/visualization build",
    "dev:all": "logbox bun run --parallel --filter '*' dev",
    "build:website": "bun run --filter @kvlm/website build",
    "build:editor": "bun run --filter @kvlm/editor build"
  },
  "devDependencies": {
    "@enke.dev/logbox": "0.0.7",
    "eslint": "10.13.0",
    "postcss": "8.5.31",
    "postcss-import": "17.0.1",
    "prettier": "3.9.10",
    "typescript": "6.0.3"
  },
  "author": {
    "name": "David Enke",
    "email": "david@kvlm.de"
  }
}
