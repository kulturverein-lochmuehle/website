---
import type { NavigationItem } from '@/utils/navigation.utils.js';

export type Props = {
  items: NavigationItem[];
  /** shown at the end of the mobile menu, where there is no footer */
  secondary?: NavigationItem[];
  current?: string;
  href?: string;
  slot?: string;
};

const { href = '/', items, secondary = [], slot } = Astro.props;
---

<kvlm-navigation slot={slot} href={href}>
  {
    items?.map(({ active, ...item }, index) => (
      <kvlm-navigation-item {...(item as any)} key={index} active={active ? true : undefined} />
    ))
  }
  {
    secondary.map(({ active, ...item }, index) => (
      <kvlm-navigation-item
        {...(item as any)}
        slot="secondary"
        key={`secondary-${index}`}
        active={active ? true : undefined}
      />
    ))
  }
</kvlm-navigation>
