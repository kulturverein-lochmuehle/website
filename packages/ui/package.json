{
  "name": "@kvlm/ui",
  "description": "UI components for kvlm.de",
  "version": "0.0.1",
  "license": "MIT",
  "private": true,
  "author": {
    "name": "David Enke",
    "email": "david@kvlm.de"
  },
  "type": "module",
  "customElements": "public/custom-elements.json",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./*.js": {
      "import": "./dist/*.js",
      "types": "./dist/*.d.ts"
    },
    "./fonts.css": "./dist/fonts.css",
    "./globals.css": "./dist/globals.css"
  },
  "scripts": {
    "lint": "eslint",
    "test": "cross-env NODE_OPTIONS='--loader tsx/esm' NODE_NO_WARNINGS=1 wtr --config .configs/web-test-runner.config.ts",
    "test:watch": "npm test -- --watch",
    "build": "vite --config .configs/vite.config.ts build",
    "dev:build": "vite --config .configs/vite.config.ts build --watch",
    "dev:serve": "vite --config .configs/vite.config.ts preview --port 3500",
    "dev": "run-p -lns dev:*"
  },
  "dependencies": {
    "@enke.dev/lit-utils": "0.2.6"
  },
  "peerDependencies": {
    "element-internals-polyfill": "^3",
    "lit": "^3",
    "lodash-es": "^4.17",
    "urlpattern-polyfill": "^10"
  },
  "devDependencies": {
    "@awmottaz/prettier-plugin-void-html": "2.0.0",
    "@csstools/css-parser-algorithms": "3.0.5",
    "@csstools/css-tokenizer": "3.0.4",
    "@custom-elements-manifest/analyzer": "0.11.0",
    "@enke.dev/lint": "0.11.10",
    "@esm-bundle/chai": "4.3.4-fix.0",
    "@lit/reactive-element": "2.1.1",
    "@lit-labs/testing": "0.2.7",
    "@open-wc/semantic-dom-diff": "0.20.1",
    "@open-wc/testing": "4.0.0",
    "@open-wc/testing-helpers": "3.0.1",
    "@remcovaes/web-test-runner-vite-plugin": "1.4.0",
    "@tsconfig/strictest": "2.0.8",
    "@types/browser-sync": "2.29.1",
    "@types/esbuild-copy-static-files": "0.1.4",
    "@types/lodash-es": "4.17.12",
    "@types/mocha": "10.0.10",
    "@types/node": "24.10.1",
    "@web/test-runner": "0.20.2",
    "@web/test-runner-commands": "0.9.0",
    "@web/test-runner-playwright": "0.11.1",
    "@webcomponents-preview/cem-plugin-examples": "0.0.45",
    "@webcomponents-preview/cem-plugin-generate-readmes": "0.0.45",
    "@webcomponents-preview/cem-plugin-grouping": "0.0.45",
    "@webcomponents-preview/client": "0.10.3",
    "@webcomponents/template-shadowroot": "0.2.1",
    "autoprefixer": "10.4.22",
    "axe-core": "4.11.0",
    "barrelsby": "2.8.1",
    "chai-a11y-axe": "1.5.0",
    "cross-env": "10.1.0",
    "element-internals-polyfill": "3.0.2",
    "esbuild": "0.27.1",
    "eslint": "9.39.1",
    "eslint-formatter-junit": "9.0.1",
    "fast-glob": "3.3.3",
    "jiti": "2.6.1",
    "lit": "3.3.1",
    "lit-element": "4.2.1",
    "lit-html": "3.3.1",
    "lodash-es": "4.17.21",
    "npm-run-all2": "8.0.4",
    "postcss": "8.5.6",
    "postcss-preset-env": "10.5.0",
    "prettier": "3.7.4",
    "resolve": "1.22.11",
    "sass": "1.94.2",
    "shx": "0.4.0",
    "tslib": "2.8.1",
    "tsx": "4.21.0",
    "typedoc": "0.28.15",
    "typescript": "5.9.3",
    "unplugin-dts": "1.0.0-beta.6",
    "vite": "7.2.6",
    "vite-plugin-cem": "0.8.4",
    "vite-plugin-checker": "0.11.0",
    "vite-plugin-lit-css": "2.2.2",
    "vite-plugin-mkcert": "1.17.9",
    "vite-plugin-node-polyfills": "0.24.0",
    "vite-plugin-static-copy": "3.1.4",
    "vite-plugin-top-level-await": "1.6.0"
  }
}
