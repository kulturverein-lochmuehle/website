{
  "name": "@kvlm/editor",
  "description": "The editor of the Lochmühle's 3D model",
  "version": "0.0.1",
  "license": "MIT",
  "private": true,
  "author": {
    "name": "David Enke",
    "email": "david@kvlm.de"
  },
  "type": "module",
  "exports": {
    ".": "./src/components/editor/editor.component.ts"
  },
  "scripts": {
    "lint": "eslint",
    "test": "cross-env NODE_OPTIONS='--import tsx/esm' NODE_NO_WARNINGS=1 wtr --config .configs/web-test-runner.config.ts",
    "test:watch": "npm test -- --watch",
    "dev": "vite --config .configs/vite.config.ts dev --host",
    "build": "bun run --sequential build:model build:check build:bundle",
    "build:model": "bun run --cwd ../visualization build",
    "build:check": "tsc --noEmit",
    "build:bundle": "vite --config .configs/vite.config.ts build"
  },
  "dependencies": {
    "@kvlm/ui": "workspace:*",
    "@kvlm/visualization": "workspace:*",
    "lit": "3.3.3",
    "three": "0.187.0"
  },
  "devDependencies": {
    "@awmottaz/prettier-plugin-void-html": "2.3.0",
    "@enke.dev/lint": "0.13.21",
    "@esm-bundle/chai": "4.3.4",
    "@open-wc/testing": "5.0.0",
    "@remcovaes/web-test-runner-vite-plugin": "1.4.1",
    "@tsconfig/strictest": "2.0.8",
    "@types/mocha": "10.0.10",
    "@types/node": "26.6.6",
    "@types/three": "0.187.0",
    "@web/test-runner": "1.0.0",
    "@web/test-runner-commands": "1.0.1",
    "@web/test-runner-playwright": "1.0.0",
    "cross-env": "10.1.0",
    "eslint": "10.14.0",
    "eslint-formatter-junit": "9.0.1",
    "jiti": "2.7.0",
    "prettier": "3.9.10",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "vite": "8.3.5"
  }
}
